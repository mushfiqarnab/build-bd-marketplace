{
  "name": "build-bd-marketplace",
  "version": "1.0.0",
  "description": "Build-BD — a private construction marketplace for Bangladesh: escrow-protected milestones between project owners and contractors.",
  "main": "server.js",
  "scripts": {
    "test": "node scripts/run-tests.js",
    "dev:local-db": "node scripts/start-local-rs.js",
    "start": "node server.js",
    "dev": "node server.js",
    "qa": "node scripts/qa/run-all.js",
    "qa:ci": "node scripts/qa/run-all.js --only static,deps,routes,schema,plans",
    "qa:live": "node scripts/qa/live-probe.js",
    "qa:load": "node scripts/qa/load-test.js",
    "qa:fuzz": "node scripts/run-tests.js --only fuzz-e2e",
    "qa:ledgers": "node scripts/qa/ledger-invariants.js",
    "qa:ultimate": "node scripts/qa/run-all.js --load && node scripts/run-tests.js --only fuzz-e2e",
    "build:frontend": "node scripts/build-frontend.js",
    "build:icons": "node scripts/build-icons.js",
    "qa:microscopic": "node scripts/qa/cli-microscopic-preflight.js",
    "ops:backup": "node scripts/ops/backup-database.js",
    "ops:verify": "node scripts/ops/verify-deployment.js",
    "ops:stress": "node scripts/stress-test-physical-economy.js",
    "preflight:zero-cost": "node scripts/ops/zero-cost-preflight.js",
    "ops:mfs": "node scripts/ops/mfs-escrow-cli.js",
    "seed:v3": "node scripts/seed-bd-market-v3.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/s3-presigned-post": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "@simplewebauthn/server": "^13.3.2",
    "axios": "^1.19.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exifreader": "^4.41.3",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "morgan": "^1.11.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "autocannon": "^8.0.0",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
