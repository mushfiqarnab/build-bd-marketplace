# Build-BD Production Environment Template — Phase 20
PORT=5000
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>?retryWrites=true&w=majority
JWT_SECRET=replace_with_strong_random_jwt_secret_min_64_chars
TREASURY_PHONE=01700000000
AUDIT_HMAC_SECRET=replace_with_strong_random_hmac_secret_key

# 🔑 WebAuthn / Passkeys (Phase 20)
# RP_ID must match the effective domain your app is served from (no port, no protocol).
# ORIGIN must match the exact origin seen by the browser (including port in dev).
WEBAUTHN_RP_NAME=Build-BD Marketplace
WEBAUTHN_RP_ID=yourdomain.com
WEBAUTHN_ORIGIN=https://yourdomain.com

# 🔴 Redis (Phase 20 — Idempotency Primary Cache)
# For local dev with docker-compose: redis://redis:6379
# For managed Redis (e.g., Upstash, Redis Cloud): rediss://:<password>@host:port
REDIS_URL=redis://localhost:6379

# ☁️ FILE STORAGE — proof photos and payment receipts (services/s3Service.js)
# Leave every line below commented out for local development: the built-in mock is used.
# In production (NODE_ENV=production) the mock is REFUSED: uploads answer 503 until this is set.
# After filling it in, prove it works:  node scripts/storage-live-check.js
#
# Recommended: Cloudflare R2 (free tier 10 GB-month, no egress fees). Uploads use presigned PUT.
# STORAGE_PROVIDER=r2
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=buildbd-evidence
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
#
# Alternative: AWS S3 (uploads use presigned POST with a store-enforced size limit).
# STORAGE_PROVIDER=aws
# S3_REGION=ap-south-1
# S3_BUCKET=buildbd-production-proofs
# S3_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
#
# Alternative (beta tier, $0): local-disk storage. Files are written under STORAGE_LOCAL_DIR
# on the Node server itself; uploads come back through this server's /__storage/upload/<token>
# endpoint. STORAGE_LOCAL_PUBLIC_URL must be the public origin that reaches this server
# (ngrok reserved domain, or your reverse-proxy hostname). In production the public URL must
# use https:// (loopback is allowed only for local testing).
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=.storage
# STORAGE_LOCAL_PUBLIC_URL=https://<your-ngrok-or-reverse-proxy-host>
# STORAGE_LOCAL_SECRET=replace_with_a_distinct_64_char_hex_secret_for_upload_tokens
#
# The older names AWS_S3_BUCKET_NAME, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION and
# S3_UPLOAD_MODE=mock still work. npm test always uses the mock (TEST_STORAGE_PROVIDER overrides).

# 🛑 PAYMENTS KILL SWITCH (Phase-1 safety)
# Set to 'true' to answer every /api/payment/* request with 503. Keep this on
# until the SSLCommerz IPN signature verification, amount comparison, val_id
# uniqueness, and mock-gateway fallthrough have been fixed and real SSLCommerz
# credentials are set below. Default (empty / absent) = payments enabled.
PAYMENTS_DISABLED=

# 💳 SSLCOMMERZ PAYMENT GATEWAY (Phase 19 Engine)
SSL_STORE_ID=buildbd_live_store
SSL_STORE_PASSWORD=buildbd_live_password
# SSL_IS_SANDBOX picks the gateway (true = sandbox.sslcommerz.com, false = securepay).
# It is independent of NODE_ENV, so a NODE_ENV=production beta can still use sandbox creds.
# The two URL overrides are optional; if set they must be https://*.sslcommerz.com and
# match the sandbox/live choice, or the server refuses to boot.
SSL_IS_SANDBOX=false
# SSL_GATEWAY_URL=https://securepay.sslcommerz.com/gwprocess/v4/api.php
# SSL_VALIDATION_URL=https://securepay.sslcommerz.com/validator/api/validationserverAPI.php

# ⏱️ WORKER INTERVALS
SETTLEMENT_POLL_MS=60000
RECONCILIATION_POLL_MS=600000

# 👻 Phase 28 — Ghost Contract Abandonment Sweeper
# EXPIRY_MS: how long a PENDING_FUNDING ledger may exist before rollback (default 60 min)
# POLL_MS:   how often the sweeper runs (default 15 min — must be < EXPIRY_MS)
CONTRACT_ABANDONMENT_EXPIRY_MS=3600000
CONTRACT_ABANDONMENT_POLL_MS=900000
