# .dockerignore — Phase 20 Zero-Trust Build Context Filter
# Keeps the Docker build context lean and prevents secrets from leaking into image layers.

# Version control
.git
.gitignore
.github

# Local environment secrets — NEVER bake these into images
.env
.env.*
!.env.example

# Development artefacts
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test suites (not needed in production image)
tests/
coverage/

# Uploads (runtime volume — not part of image)
uploads/

# Documentation & local scripts
*.md
README*
CHANGELOG*

# IDE configs
.vscode/
.idea/
*.swp
*.swo

# OS artefacts
.DS_Store
Thumbs.db

# Build tools
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
